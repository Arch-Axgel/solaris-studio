   "description": "An example pipeline. It finds stretches that are clearly louder than the rest of the video and starts each clip on the nearest scene cut before it, using FFmpeg only. It knows nothing about what is happening on screen: loud is not always interesting, and quiet highlights are missed.\n",
   "events": [
    "loud"
   ],
   "execution": "local",
   "id": "solaris-studio-examples/scene-cut-highlights",
   "inputs": [
    "video"
   ],
   "kind": "pipeline",
   "latest": "1.0.0",
   "license": "MIT",
   "metrics": {},
   "name": "Loud moments, cut on scene changes (example)",
   "network": [],
   "outputs": [
    "ranges"
   ],
   "path": "examples/pipelines/scene-cut-highlights",
   "permissions": [
    "video.read",
    "ffmpeg"
   ],
   "publisher": "solaris-studio-examples",
   "relationship": "built-for",
   "repository": "https://github.com/Arch-Axgel/solaris-studio",
   "requirements": {
    "gpu": "none",
    "os": [
     "windows",
     "macos",
     "linux"
    ]
   },
   "run": {
    "command": [
     "{python}",
     "src/main.py"
    ],
    "timeout_minutes": 30
   },
   "section": "general",
   "sends": [],
   "settings": {
    "lead_in_seconds": {
     "title": "Seconds to keep before the loud part when no cut is near",
     "type": "number"
    },
